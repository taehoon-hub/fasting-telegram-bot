/* BOARD CSS VERSION: 20260819-2315 */
* {
  box-sizing: border-box;
}

:root {
  color-scheme: light;
  --page-bg: #f5f5f5;
  --card-bg: #ffffff;
  --section-bg: #fafafa;
  --button-bg: #e9e9e9;
  --text: #202020;
  --muted: #777777;
  --line: #e2e2e2;
  --shadow: 0 6px 22px rgba(0, 0, 0, 0.06);
}

html,
body {
  margin: 0;
  min-height: 100%;
}

body {
  background: var(--page-bg);
  color: var(--text);
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Apple SD Gothic Neo",
    "Noto Sans KR",
    sans-serif;
  line-height: 1.5;
}

button {
  border: 0;
  color: inherit;
  cursor: pointer;
  font: inherit;
}

.board-shell {
  width: min(100% - 32px, 720px);
  margin: 24px auto;
  padding: 30px;
  background: var(--card-bg);
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.board-header {
  margin-bottom: 24px;
}

.board-header h1 {
  margin: 0 0 14px;
  font-size: clamp(30px, 7vw, 42px);
  letter-spacing: -0.07em;
}

.board-header h1 span {
  margin-left: 8px;
  color: #999;
  font-size: 0.48em;
  font-weight: 400;
  letter-spacing: -0.04em;
}

.board-header p {
  margin: 4px 0;
  color: var(--muted);
  font-size: 15px;
}

.board-note {
  font-size: 13px !important;
}

.refresh-button,
.back-button {
  width: 100%;
  min-height: 58px;
  margin-top: 20px;
  border-radius: 17px;
  background: var(--button-bg);
  font-size: 17px;
  font-weight: 700;
}

.refresh-button:active,
.back-button:active {
  transform: scale(0.99);
}

.board-card {
  margin-top: 22px;
  padding: 24px 20px 20px;
  overflow: hidden;
  background: var(--section-bg);
  border-radius: 22px;
}

.board-card h2 {
  margin: 0;
  font-size: clamp(22px, 5vw, 29px);
  letter-spacing: -0.06em;
}

#active-count {
  margin-left: 8px;
  color: var(--muted);
  font-size: 14px;
  font-weight: 400;
}

.section-description {
  margin: 18px 0;
  color: var(--muted);
}

.status-box {
  padding: 12px 0;
  color: var(--muted);
}

.status-box.error {
  color: #b42318;
}

.desktop-table-wrap {
  width: 100%;
  overflow-x: auto;
}

.board-table {
  width: 100%;
  min-width: 560px;
  border-collapse: collapse;
  table-layout: fixed;
  font-size: 14px;
}

.board-table th,
.board-table td {
  padding: 10px 5px;
  border-bottom: 1px solid var(--line);
  text-align: center;
  white-space: nowrap;
}

.board-table th:nth-child(2),
.board-table td:nth-child(2) {
  text-align: left;
}

.board-table th {
  color: #777;
  font-weight: 500;
}

.board-table td {
  font-weight: 500;
}

.mobile-list {
  display: none;
}

.mobile-card {
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
}

.mobile-card:last-child {
  border-bottom: 0;
}

.mobile-card-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
}

.mobile-card-name {
  font-size: 18px;
  font-weight: 700;
}

.mobile-card-percent {
  font-size: 18px;
  font-weight: 700;
}

.mobile-card-meta {
  margin-top: 4px;
  color: var(--muted);
  font-size: 14px;
}

.mobile-scores {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  margin-top: 12px;
}

.mobile-score {
  padding: 7px 2px;
  border-radius: 8px;
  background: #eeeeee;
  text-align: center;
  font-size: 12px;
}

.mobile-score strong {
  display: block;
  font-size: 15px;
}

.back-button {
  margin-top: 24px;
}

@media (max-width: 600px) {
  .board-shell {
    width: calc(100% - 16px);
    margin: 8px auto;
    padding: 18px 8px;
    border-radius: 20px;
  }

  .board-card {
    padding: 18px 6px 12px;
    border-radius: 18px;
  }

  .desktop-table-wrap {
    display: block;
    width: 100%;
    overflow: visible;
  }

  .mobile-list {
    display: none !important;
  }

  .board-table {
    width: 100%;
    min-width: 0;
    table-layout: fixed;
    font-size: 10px;
  }

  .board-table th,
  .board-table td {
    padding: 8px 1px;
    white-space: nowrap;
    text-align: center;
  }

  .board-table th:nth-child(1),
  .board-table td:nth-child(1) {
    width: 11%;
  }

  .board-table th:nth-child(2),
  .board-table td:nth-child(2) {
    width: 20%;
    overflow: hidden;
    text-align: left;
    text-overflow: ellipsis;
  }

  .board-table th:nth-child(3),
  .board-table td:nth-child(3) {
    width: 13%;
  }

  .board-table th:nth-child(4),
  .board-table td:nth-child(4) {
    width: 11%;
  }

  .board-table th:nth-child(n + 5),
  .board-table td:nth-child(n + 5) {
    width: 11.25%;
  }
}/* Compact dashboard header */
.board-header {
  margin-bottom: 14px;
}

.board-header h1 {
  margin: 0 0 8px;
  font-size: clamp(24px, 6vw, 32px);
  letter-spacing: -0.06em;
}

.board-header h1 span {
  margin-left: 5px;
  font-size: 0.52em;
}

.board-header p {
  margin: 3px 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.45;
}

.board-note {
  display: none;
}

.refresh-button {
  width: auto;
  min-width: 88px;
  min-height: 44px;
  margin-top: 8px;
  padding: 9px 14px;
  border-radius: 10px;
  background: transparent;
  border: 1px solid var(--line);
  color: var(--muted);
  font-size: 13px;
  font-weight: 600;
}

.refresh-button:active {
  transform: scale(0.98);
}

.open-chat-card {
  margin-top: 10px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--section-bg);
}

.open-chat-card h2 {
  margin: 0 0 3px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.open-chat-card p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.4;
}

.open-chat-button {
  min-height: 44px;
  margin-top: 7px;
  padding: 7px 11px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--button-bg);
  color: var(--text);
  font-size: 12px;
  font-weight: 600;
}

.board-card {
  margin-top: 16px;
  padding: 20px 16px 16px;
}

.board-card h2 {
  font-size: clamp(20px, 4.5vw, 26px);
}

@media (max-width: 600px) {
  .board-header {
    margin-bottom: 10px;
  }

  .board-header h1 {
    font-size: 26px;
  }

  .open-chat-card {
    margin-top: 8px;
    padding: 9px 10px;
  }

  .open-chat-card h2 {
    font-size: 12px;
  }

  .open-chat-card p {
    font-size: 11px;
  }

  .refresh-button,
  .open-chat-button {
    min-height: 44px;
  }

  .board-card {
    margin-top: 14px;
    padding: 16px 6px 12px;
  }
}

/* Completed board readability */
.completed-table th:nth-child(1),
.completed-table td:nth-child(1) {
  width: 30%;
  text-align: left;
  padding-left: 12px;
}

.completed-table th:nth-child(2),
.completed-table td:nth-child(2) {
  width: 16%;
}

.completed-table th:nth-child(n + 3),
.completed-table td:nth-child(n + 3) {
  width: 10.8%;
  text-align: center;
}

.status-box {
  font-size: 14px;
}

.section-description {
  font-size: 13px;
}